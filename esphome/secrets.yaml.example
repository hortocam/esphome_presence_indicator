# Secrets - LOCAL ONLY, never commit
# Copy to secrets.yaml, fill in real values. This file is gitignored.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant native API encryption key (api.encryption.key).
# Generate with: `openssl rand -base64 32`
api_key: "YOUR_32_BYTE_BASE64_KEY"

# OTA password
ota_password: "YOUR_OTA_PASSWORD"
